{
  "name": "dumbbell",
  "image": "nvidia/cuda:12.2.0-devel-ubuntu22.04",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopContainer",
  "mounts": [
    {
      "source": "dumbbell-cargo-registry",
      "target": "/usr/local/cargo/registry",
      "type": "volume"
    },
    {
      "source": "dumbbell-cargo-git",
      "target": "/usr/local/cargo/git",
      "type": "volume"
    },
    {
      "source": "dumbbell-tools",
      "target": "/home/tutu/.local",
      "type": "volume"
    },
    {
      "source": "dumbbell-target",
      "target": "/workspace/target",
      "type": "volume"
    }
  ],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": true,
      "username": "tutu"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "1.96.0"
    },
    "ghcr.io/devcontainers-extra/features/apt-packages:1": {
      "packages": "build-essential,clang,pkg-config,libssl-dev"
    }
  },
  "runArgs": ["--device=nvidia.com/gpu=all"],
  "containerUser": "tutu",
  "remoteUser": "tutu",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "CARGO_TERM_COLOR": "always",
    "CARGO_INSTALL_ROOT": "/home/tutu/.local"
  },
  "remoteEnv": {
    "PATH": "/home/tutu/.local/bin:${containerEnv:PATH}"
  },
  "onCreateCommand": "sudo mkdir -p /workspace/target /home/tutu/.local/bin && sudo chown -R tutu:tutu /workspace/target /home/tutu/.local /usr/local/cargo/registry /usr/local/cargo/git",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "vadimcn.vscode-lldb",
        "ms-vscode.cpptools",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "NVIDIA.nsight-vscode-edition",
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.persistentSessionReviveProcess": "never",
        "terminal.integrated.enablePersistentSessions": false
      }
    }
  }
}
