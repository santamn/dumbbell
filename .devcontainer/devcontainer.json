{
  "name": "dumbbell",
  "image": "nvidia/cuda:12.2.0-devel-ubuntu22.04",
  "workspaceFolder": "/workspace",
  "mounts": [
    {
      "source": "${localWorkspaceFolder}",
      "target": "/workspace",
      "type": "bind"
    },
    {
      "source": "dumbbell-cargo-registry",
      "target": "/usr/local/cargo/registry",
      "type": "volume"
    },
    {
      "source": "dumbbell-cargo-bin",
      "target": "/usr/local/cargo/bin",
      "type": "volume"
    },
    {
      "source": "dumbbell-cargo-git",
      "target": "/usr/local/cargo/git",
      "type": "volume"
    },
    {
      "source": "dumbbell-target",
      "target": "${containerWorkspaceFolder}/target",
      "type": "volume"
    },
    {
      "source": "${env:SSH_AUTH_SOCK}",
      "target": "/ssh-agent",
      "type": "bind"
    }
  ],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": "true",
      "username": "tutu"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "1.96.0"
    },
    "ghcr.io/devcontainers-extra/features/apt-packages:1": {
      "packages": "build-essential, clang, mold, ripgrep, fd-find, tmux, pkg-config, libssl-dev"
    }
  },
  "runArgs": ["--device=nvidia.com/gpu=all"],
  "containerUser": "tutu",
  "postCreateCommand": {
    "fetch-deps": "cargo fetch",
    "install-ax": "curl -fsSL https://ax.yusuke.run/install | AX_INSTALL_DIR=/usr/bin sh",
    "install-ast-grep": "cargo install ast-grep --locked",
    "install-sem": "cargo install --git https://github.com/Ataraxy-Labs/sem sem-cli"
  },
  "containerEnv": {
    "CARGO_TERM_COLOR": "always",
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vadimcn.vscode-lldb",
        "ms-vscode.cpptools",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "NVIDIA.nsight-vscode-edition",
        "anthropic.claude-code"
      ]
    }
  }
}
